APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Reported by /health, the app-shell footer and `php artisan app:version`.
# A deploy may set these from the release tag; otherwise the VERSION file is used.
# APP_VERSION=
# APP_COMMIT=

APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production: the session cookie is then sent over HTTPS only.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production (cPanel)
#
# The setup wizard (/install) writes the live .env for you, and
# `php artisan app:install` does the same over SSH. This block is the reference
# for a manual setup. Never commit the live .env — it holds credentials.
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-host
# APP_TIMEZONE=Asia/Dhaka
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpaneluser_app
# DB_USERNAME=cpaneluser_app
# DB_PASSWORD=change-me
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# CACHE_STORE=database
# QUEUE_CONNECTION=database
# LOG_LEVEL=warning
# MAIL_MAILER=smtp
# MAIL_HOST=mail.your-host
# MAIL_PORT=587
# MAIL_USERNAME=noreply@your-host
# MAIL_PASSWORD=change-me
# MAIL_FROM_ADDRESS="noreply@your-host"
